{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": ["src/Main/App/**/*.ts", "src/Main/DeepSeek/**/*.ts", "src/Main/Server/**/*.ts", "src/Shared/**/*.ts", "src/Scripts/**/*.ts"]
}